# Required: Nebius Token Factory (Nemotron inference + Sandboxes).
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=

# Optional: Tavily, used only when a fix needs docs for an unfamiliar API.
TAVILY_API_KEY=

# Optional: only for `scripts/run_repo.py --live`. The web UI asks for the
# token per run instead of reading it from here.
GITHUB_TOKEN=
